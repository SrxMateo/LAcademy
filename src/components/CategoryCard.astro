---
interface Props {
  id: string;
  title: string;
  description: string;
  icon: string;
  href: string;
  color?: string;
}

const { id, title, description, icon, href, color = 'var(--primary)' } = Astro.props;
---
<a href={href} class="card glass locked" data-category-id={id} id={`card-${id}`}>
  <div class="lock-overlay">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
  </div>
  <div class="icon-wrapper" style={`--icon-color: ${color}`}>
    <Fragment set:html={icon} />
  </div>
  <div class="content">
    <h3 transition:name={`title-${id}`}>{title}</h3>
    <p>{description}</p>
    <div class="progress-container">
      <div class="progress-bar" id={`pb-${id}`}></div>
    </div>
  </div>
  <div class="arrow">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
  </div>
</a>

<script define:vars={{ id }}>
  const updateProgress = () => {
    const progress = JSON.parse(localStorage.getItem('lacademy_progress') || '{}');
    const bar = document.getElementById(`pb-${id}`);
    if (bar && progress[id]) {
      bar.style.width = '100%';
    }
  };
  
  updateProgress();
  document.addEventListener('astro:after-swap', updateProgress);
</script>

<style>
  .card {
    border-radius: 1.25rem;
    padding: 1.75rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
  }
  .card.locked {
    pointer-events: none;
    filter: grayscale(0.8);
    opacity: 0.7;
    border-style: dashed;
  }
  .lock-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.1);
    display: none;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    z-index: 5;
  }
  .card.locked .lock-overlay {
    display: flex;
  }
  .card.locked .arrow {
    display: none;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }
  .icon-wrapper {
    width: 50px;
    height: 50px;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--icon-color), transparent 85%);
    color: var(--icon-color);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .content {
    flex-grow: 1;
  }
  .content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .content p {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .arrow {
    color: var(--text-muted);
    transition: transform 0.2s, color 0.2s;
  }
  .card:hover .arrow {
    transform: translateX(4px);
    color: var(--primary);
  }

  @media (max-width: 640px) {
    .card {
      padding: 1.25rem;
    }
    .icon-wrapper {
      width: 44px;
      height: 44px;
    }
  }
</style>
