---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const tools = [
  {
    name: "Whimsical AI",
    description: "Transforma tus ideas desordenadas en mapas mentales, diagramas de flujo y wireframes coherentes. Su IA te ayuda a expandir conceptos automáticamente.",
    prompt: "Genera un mapa mental sobre los componentes principales de un sistema operativo moderno.",
    type: "Mapas & Diagramas",
    useCase: "Ideal para planificar proyectos de software y organizar sesiones de brainstorming."
  },
  {
    name: "ChatMind",
    description: "Una herramienta diseñada específicamente para convertir texto en estructuras jerárquicas visuales. Puedes chatear con tu mapa mental para añadir más nodos.",
    prompt: "Resume el concepto de 'Economía Circular' en un diagrama de 5 niveles.",
    type: "Visualización",
    useCase: "Perfecto para resumir libros, artículos largos o conferencias complejas."
  },
  {
    name: "Perplexity AI",
    description: "No es solo un buscador, es una herramienta de investigación con fuentes citadas. Te ayuda a entender temas complejos con explicaciones paso a paso.",
    prompt: "¿Cómo funciona el algoritmo de consenso Proof of Stake en Ethereum? Explícalo para un estudiante de secundaria.",
    type: "Investigación",
    useCase: "Sustituye a Google para obtener respuestas directas y verificadas."
  }
];

const methods = [
  {
    title: "El Método de Estudio 2.0",
    steps: [
      { t: "Captura", d: "Usa Perplexity para investigar un tema y obtener fuentes fiables." },
      { t: "Estructura", d: "Pasa los puntos clave a Whimsical para crear un mapa conceptual visual." },
      { t: "Sintetiza", d: "Usa ChatMind para crear un resumen jerárquico que puedas repasar rápidamente." },
      { t: "Verifica", d: "Pide a un LLM que te haga un examen rápido sobre el mapa que creaste." }
    ]
  }
];
---

<BaseLayout title="IAs para Estudio">
  <Header />
  <main class="container">
    <a href="/" class="btn-back">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Volver al Lobby
    </a>

    <section class="hero animate-fade">
      <h1>IAs para <span class="gradient-text">Productividad y Estudio</span></h1>
      <p>Aumenta tu capacidad de aprendizaje x10. Estas herramientas te ayudan a procesar información, organizar ideas y dominar cualquier tema en tiempo récord.</p>
    </section>

    <div class="study-grid animate-fade" style="animation-delay: 0.1s;">
      {tools.map(tool => (
        <div class="study-card glass">
          <div class="card-header">
            <span class="type-badge">{tool.type}</span>
            <h3>{tool.name}</h3>
          </div>
          <p>{tool.description}</p>
          <div class="use-case">
            <strong>Caso de uso:</strong> {tool.useCase}
          </div>
          <div class="prompt-box">
            <span class="prompt-label">Ejemplo de entrada:</span>
            <code>{tool.prompt}</code>
          </div>
          <button class="btn-primary" style="margin-top: 2rem;">Acceder a {tool.name}</button>
        </div>
      ))}
    </div>

    <section class="methodology animate-fade" style="animation-delay: 0.2s;">
      <div class="method-card glass">
        <h2>{methods[0].title}</h2>
        <div class="steps-container">
          {methods[0].steps.map((step, i) => (
            <div class="method-step">
              <div class="step-icon">{i + 1}</div>
              <div class="step-text">
                <h4>{step.t}</h4>
                <p>{step.d}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <div class="complete-box animate-fade">
      <button class="btn-3d btn-complete" data-category="study-ai">Marcar como Completado</button>
    </div>
  </main>
</BaseLayout>

<script>
  function setupCompletion() {
    const btn = document.querySelector('.btn-complete');
    const cat = btn?.getAttribute('data-category');
    if (btn && cat) {
      const progress = JSON.parse(localStorage.getItem('lacademy_progress') || '{}');
      if (progress[cat]) btn.textContent = '✅ Lección Completada';

      btn.addEventListener('click', () => {
        progress[cat] = true;
        localStorage.setItem('lacademy_progress', JSON.stringify(progress));
        btn.textContent = '✅ Lección Completada';

        const xp = parseInt(localStorage.getItem('lacademy_xp') || '0');
        localStorage.setItem('lacademy_xp', (xp + 500).toString());

        alert('¡Progreso guardado! Revisa el lobby para ver tu avance.');
      });
    }
  }
  setupCompletion();
  document.addEventListener('astro:after-swap', setupCompletion);
</script>

<style>
  .complete-box { margin: 4rem 0; text-align: center; }
  .hero { text-align: center; padding: 4rem 0; max-width: 800px; margin: 0 auto; }
  .hero p { color: var(--text-muted); font-size: 1.1rem; margin-top: 1rem; }

  .study-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2.5rem; margin-bottom: 5rem; }
  .study-card { padding: 2.5rem; border-radius: 2rem; display: flex; flex-direction: column; }
  .card-header { margin-bottom: 1.5rem; }
  .type-badge { background: var(--primary); color: white; padding: 0.2rem 0.6rem; border-radius: 0.5rem; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; margin-bottom: 0.75rem; display: inline-block; }
  .study-card h3 { font-size: 1.8rem; color: var(--primary); }
  .study-card p { color: var(--text-muted); line-height: 1.6; margin-bottom: 1.5rem; }
  
  .use-case { background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); padding: 1rem; border-radius: 0.75rem; color: var(--success); font-size: 0.9rem; margin-bottom: 1.5rem; }
  .use-case strong { color: var(--success); }

  .prompt-box { background: rgba(0,0,0,0.2); padding: 1.25rem; border-radius: 1rem; border-left: 4px solid var(--accent); margin-top: auto; }
  .prompt-label { display: block; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 0.5rem; color: var(--accent); }
  code { font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: var(--text); }

  .methodology { margin-bottom: 6rem; }
  .method-card { padding: 4rem; border-radius: 2.5rem; }
  .method-card h2 { font-size: 2.5rem; margin-bottom: 3rem; text-align: center; }
  .steps-container { display: flex; flex-direction: column; gap: 2rem; max-width: 800px; margin: 0 auto; }
  .method-step { display: flex; gap: 2rem; align-items: flex-start; }
  .step-icon { width: 40px; height: 40px; background: var(--primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 800; box-shadow: 0 0 15px rgba(99, 102, 241, 0.3); }
  .step-text h4 { font-size: 1.3rem; margin-bottom: 0.5rem; color: var(--primary); }
  .step-text p { color: var(--text-muted); line-height: 1.5; }

  @media (max-width: 768px) {
    .method-card { padding: 2.5rem; }
    .method-step { flex-direction: column; gap: 1rem; text-align: center; align-items: center; }
  }
</style>
