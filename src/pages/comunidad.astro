---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const stats = [
  { label: "Miembros", value: "2,500+" },
  { label: "Plugins creados", value: "150+" },
  { label: "Proyectos Web", value: "300+" }
];
---

<BaseLayout title="Comunidad">
  <Header />
  <main class="container">
    <a href="/" class="btn-back">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Volver al Lobby
    </a>

    <section class="hero animate-fade">
      <h1>Únete a la <span class="gradient-text">Comunidad</span></h1>
      <p>No aprendas solo. Conecta con otros desarrolladores, comparte tus proyectos y resuelve dudas en tiempo real.</p>
    </section>

    <div class="community-grid animate-fade" style="animation-delay: 0.1s;">
      <div class="discord-card glass">
        <div class="discord-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="#5865F2"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          <h2>LumaCorp Studio</h2>
        </div>
        <p>Nuestro centro de operaciones. Donde la magia sucede.</p>
        <a href="https://discord.gg/lumacorp" target="_blank" class="btn-discord">Unirse al Servidor</a>
      </div>

      <div class="stats-grid">
        {stats.map(stat => (
          <div class="stat-card glass">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .hero { text-align: center; padding: 4rem 0; }
  .community-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-bottom: 6rem; }
  
  .discord-card { padding: 4rem; border-radius: 2.5rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .discord-header { display: flex; align-items: center; gap: 1rem; }
  .btn-discord { background: #5865F2; color: white; padding: 1rem 2.5rem; border-radius: 1rem; font-weight: 700; transition: transform 0.3s, box-shadow 0.3s; }
  .btn-discord:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(88, 101, 242, 0.4); }

  .stats-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  .stat-card { padding: 2rem; border-radius: 1.5rem; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .stat-value { font-size: 2.5rem; font-weight: 900; color: var(--primary); display: block; }
  .stat-label { font-size: 1rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; }

  @media (max-width: 768px) {
    .community-grid { grid-template-columns: 1fr; }
    .discord-card { padding: 2rem; }
  }
</style>
