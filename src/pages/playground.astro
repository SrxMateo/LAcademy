---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

---

<BaseLayout title="Code Playground">
  <Header />
  <main class="container">
    <a href="/" class="btn-back">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Volver al Lobby
    </a>

    <section class="hero animate-fade">
      <h1>Luma <span class="gradient-text">Playground</span></h1>
      <p>Escribe HTML, CSS y JavaScript para ver tus ideas cobrar vida al instante.</p>
    </section>

    <div class="playground-container animate-fade">
      <div class="editors">
        <div class="editor-block glass">
          <label>HTML</label>
          <textarea id="html-code" placeholder="<div>Hola Mundo</div>"></textarea>
        </div>
        <div class="editor-block glass">
          <label>CSS</label>
          <textarea id="css-code" placeholder="div { color: red; }"></textarea>
        </div>
        <div class="editor-block glass">
          <label>JS</label>
          <textarea id="js-code" placeholder="console.log('L-Academy');"></textarea>
        </div>
      </div>
      <div class="preview-block glass">
        <label>Resultado en Vivo</label>
        <iframe id="preview-frame"></iframe>
      </div>
    </div>
  </main>

  <script>
    function setupPlayground() {
      const html = document.getElementById('html-code') as HTMLTextAreaElement;
      const css = document.getElementById('css-code') as HTMLTextAreaElement;
      const js = document.getElementById('js-code') as HTMLTextAreaElement;
      const frame = document.getElementById('preview-frame') as HTMLIFrameElement;

      function update() {
        const content = `
          <html>
            <style>${css?.value}</style>
            <body>
              ${html?.value}
              <script>${js?.value}<\/script>
            </body>
          </html>
        `;
        const doc = frame?.contentDocument || frame?.contentWindow?.document;
        if (doc) {
          doc.open();
          doc.write(content);
          doc.close();
        }
      }

      [html, css, js].forEach(el => el?.addEventListener('input', update));
      update();
    }

    setupPlayground();
    document.addEventListener('astro:after-swap', setupPlayground);
  </script>
</BaseLayout>

<style>
  .hero { text-align: center; padding: 3rem 0; }
  .playground-container { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; height: 600px; margin-bottom: 6rem; }
  
  .editors { display: flex; flex-direction: column; gap: 1rem; }
  .editor-block { flex: 1; padding: 1rem; display: flex; flex-direction: column; }
  .editor-block label { font-size: 0.7rem; font-weight: 800; color: var(--primary); text-transform: uppercase; margin-bottom: 0.5rem; }
  .editor-block textarea { flex: 1; background: transparent; border: none; color: var(--text); font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; outline: none; resize: none; }

  .preview-block { display: flex; flex-direction: column; padding: 1rem; overflow: hidden; }
  .preview-block label { font-size: 0.7rem; font-weight: 800; color: var(--accent); text-transform: uppercase; margin-bottom: 0.5rem; }
  iframe { flex: 1; width: 100%; border: none; background: #fff; border-radius: 0.5rem; }

  @media (max-width: 1024px) {
    .playground-container { grid-template-columns: 1fr; height: auto; }
    iframe { min-height: 300px; }
  }
</style>
