      .msg.bot { background: var(--card); border: 1px solid var(--border); color: var(--text); border-bottom-left-radius: 0.2rem; }
      .msg.user { background: var(--primary); color: white; border-bottom-right-radius: 0.2rem; box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3); }
      
      .chat-suggestions { padding: 0.5rem 1rem; display: flex; gap: 0.5rem; overflow-x: auto; background: var(--background); border-top: 1px solid var(--border); scrollbar-width: none; }
      .chat-suggestions::-webkit-scrollbar { display: none; }
      .suggestion-chip { background: var(--card); border: 1px solid var(--border); padding: 0.4rem 0.8rem; border-radius: 99px; font-size: 0.75rem; white-space: nowrap; cursor: pointer; transition: all 0.2s; color: var(--text-muted); }
