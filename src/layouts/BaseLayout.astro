      .chat-input button { background: var(--primary); border: none; color: white; width: 38px; height: 38px; border-radius: 0.75rem; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; }
      .chat-input button:hover { transform: scale(1.1); filter: brightness(1.1); }
