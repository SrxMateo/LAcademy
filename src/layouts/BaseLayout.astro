---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

declare global {
  interface Window {
    unlockAchievement: (id: string, name: string, icon: string, xp: number) => void;
    notify: (message: string, icon?: string, type?: 'success' | 'error' | 'info') => void;
  }
}

interface Props {
	title: string;
	description?: string;
}

const { title, description = "L-Academy - Aprende sobre IA y Prompt Engineering" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<ViewTransitions />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | L-Academy</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
		<script is:inline>
			const getTheme = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			};
			const theme = getTheme();
			document.documentElement.setAttribute('data-theme', theme);

			document.addEventListener('astro:after-swap', () => {
				document.documentElement.setAttribute('data-theme', getTheme());
			});
		</script>
		<style is:global>
      /* Luma Toast Ultra-Premium */
      .luma-toast {
        position: fixed;
        bottom: 2.5rem;
        left: 50%;
        transform: translateX(-50%) translateY(120px) scale(0.9);
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1rem 2rem;
        border-radius: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), inset 0 0 15px rgba(255, 255, 255, 0.05);
        z-index: 10001;
        transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1);
        opacity: 0;
        pointer-events: none;
        min-width: 300px;
        overflow: hidden;
      }
      .luma-toast.active { transform: translateX(-50%) translateY(0) scale(1); opacity: 1; pointer-events: auto; }
      
      .toast-icon-box {
        width: 38px;
        height: 38px;
        background: rgba(99, 102, 241, 0.15);
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        box-shadow: 0 0 15px rgba(99, 102, 241, 0.2);
        flex-shrink: 0;
      }
      
      .toast-content { flex: 1; }
      .toast-content p { margin: 0; font-size: 0.95rem; font-weight: 700; color: #fff; letter-spacing: 0.01em; }
      
      /* Barra de progreso de la notificación */
      .toast-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 4px;
        background: var(--primary);
        width: 100%;
        transform-origin: left;
      }
      .luma-toast.active .toast-progress {
        animation: toast-timer 3s linear forwards;
      }
      @keyframes toast-timer {
        from { transform: scaleX(1); }
        to { transform: scaleX(0); }
      }

      /* Variaciones de color */
      .luma-toast.success { border-bottom: 2px solid #22c55e; }
      .luma-toast.error { border-bottom: 2px solid #f43f5e; }
      .luma-toast.info { border-bottom: 2px solid #3b82f6; }

      /* Notificaciones de Logros */
      .achievement-toast {
        position: fixed;
        top: 2rem;
        right: 2rem;
        background: rgba(10, 10, 15, 0.95);
        border: 1px solid var(--primary);
        border-left: 5px solid var(--primary);
        padding: 1.25rem;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        z-index: 10000;
        transform: translateX(120%);
        transition: transform 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        max-width: 350px;
      }
      .achievement-toast.active { transform: translateX(0); }
      .achievement-icon {
        font-size: 2rem;
        background: rgba(99, 102, 241, 0.1);
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.75rem;
      }
      .achievement-info h4 { margin: 0; color: var(--primary); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .achievement-info p { margin: 0.25rem 0 0; font-size: 1rem; font-weight: 600; color: #fff; }
      .achievement-xp { font-size: 0.75rem; color: var(--accent); font-weight: 800; margin-top: 0.25rem; display: block; }

			.bg-glow {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: 
					radial-gradient(circle at 20% 30%, rgba(99, 102, 241, 0.05) 0%, transparent 40%),
					radial-gradient(circle at 80% 70%, rgba(245, 158, 11, 0.05) 0%, transparent 40%);
				pointer-events: none;
				z-index: -1;
			}
      #particles-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: -1;
        opacity: 0.3;
      }
      .luma-console {
        position: fixed;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.9);
        width: 700px;
        max-width: 95vw;
        background: rgba(10, 10, 15, 0.98);
        border: 1px solid var(--primary);
        box-shadow: 0 0 40px rgba(99, 102, 241, 0.3), inset 0 0 20px rgba(99, 102, 241, 0.1);
        z-index: 9999;
        padding: 0;
        border-radius: 0.75rem;
        font-family: 'JetBrains Mono', monospace;
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s cubic-bezier(0.19, 1, 0.22, 1);
        overflow: hidden;
      }
      .luma-console.open {
        opacity: 1;
        pointer-events: auto;
        transform: translate(-50%, -50%) scale(1);
      }
      .console-top-bar {
        background: rgba(255, 255, 255, 0.05);
        padding: 0.5rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }
      .dot-red { width: 12px; height: 12px; background: #ff5f56; border-radius: 50%; }
      .dot-yellow { width: 12px; height: 12px; background: #ffbd2e; border-radius: 50%; }
      .dot-green { width: 12px; height: 12px; background: #27c93f; border-radius: 50%; }
      .console-title { font-size: 0.75rem; color: #666; margin-left: 1rem; text-transform: uppercase; letter-spacing: 0.1em; }
      .console-body { padding: 1.5rem; }
      .console-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
      .console-prompt { color: var(--primary); font-weight: 700; font-size: 1rem; }
      .console-input {
        flex: 1;
        background: transparent;
        border: none;
        color: #fff;
        font-size: 1rem;
        outline: none;
        caret-color: var(--primary);
      }
      .console-output {
        margin-top: 1rem;
        height: 250px;
        overflow-y: auto;
        color: #d1d1d1;
        font-size: 0.85rem;
        line-height: 1.5;
        scrollbar-width: thin;
        scrollbar-color: var(--primary) transparent;
      }
      .console-output div { margin-bottom: 0.25rem; }
      .console-output::-webkit-scrollbar { width: 4px; }
      .console-output::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 10px; }
		</style>
	</head>
	<body>
		<div class="bg-glow"></div>
    <canvas id="particles-canvas"></canvas>

    <!-- Luma Console (Easter Egg: Ctrl+K) -->
    <div id="luma-console" class="luma-console">
      <div class="console-top-bar">
        <div class="dot-red"></div>
        <div class="dot-yellow"></div>
        <div class="dot-green"></div>
        <span class="console-title">luma-terminal — 80x24</span>
      </div>
      <div class="console-body">
        <div class="console-header">
          <span class="console-prompt">LumaOS ~</span>
          <input type="text" id="console-input" class="console-input" placeholder="Escribe 'help'..." autofocus />
        </div>
        <div id="console-output" class="console-output">
          <div style="color:var(--primary); font-weight:bold;">Welcome to LumaOS v2.0.0 (Astro-Kernel)</div>
          <div style="font-size:0.7rem; opacity:0.5; margin-bottom:1rem;">Type 'help' to see available commands. Press Esc to close.</div>
        </div>
      </div>
    </div>

    <!-- Luma Toast Notification Ultra -->
    <div id="luma-toast" class="luma-toast">
      <div class="toast-icon-box" id="toast-icon">✨</div>
      <div class="toast-content">
        <p id="toast-message">Mensaje de notificación</p>
      </div>
      <div class="toast-progress" id="toast-pb"></div>
    </div>

    <!-- Achievement Toast -->
    <div id="achievement-toast" class="achievement-toast">
      <div class="achievement-icon" id="achievement-icon">🏆</div>
      <div class="achievement-info">
        <h4>¡Logro Desbloqueado!</h4>
        <p id="achievement-name">Nombre del Logro</p>
        <span class="achievement-xp" id="achievement-xp">+500 XP</span>
      </div>
    </div>

		<slot />

    <!-- AI Tutor FAB -->
    <div class="ai-tutor-container">
      <div id="ai-chat" class="ai-chat-window hidden">
        <div class="chat-header">
          <div class="chat-header-info">
            <div style="position: relative;">
              <div class="header-avatar">🤖</div>
              <div class="status-dot"></div>
            </div>
            <div class="header-text">
              <h3>LumaX Assistant</h3>
              <span>Online • Experto en Código</span>
            </div>
          </div>
          <div class="personality-container">
            <div class="personality-tabs" id="personality-tabs">
              <button class="p-tab active" data-value="standard" title="Modo Normal">🤖</button>
              <button class="p-tab" data-value="socratic" title="Modo Socrático">🤔</button>
              <button class="p-tab" data-value="strict" title="Modo Estricto">👨‍🏫</button>
            </div>
            <button id="close-chat" style="background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer;">×</button>
          </div>
        </div>
        
        <div id="chat-messages" class="chat-messages">
          <!-- Los mensajes se inyectan aquí con JS -->
        </div>

        <div class="chat-suggestions" id="chat-suggestions">
          <div class="suggestion-chip">¿Qué es Astro?</div>
          <div class="suggestion-chip">Plugins Minecraft</div>
          <div class="suggestion-chip">Hacer video IA</div>
          <div class="suggestion-chip">Seguridad VPS</div>
        </div>

        <div class="chat-input">
          <input type="text" id="user-input" placeholder="Escribe un mensaje..." />
          <button id="send-msg">➤</button>
        </div>
      </div>
      <button id="ai-toggle" class="ai-fab btn-3d">
        <span>🤖 Tutor LumaX</span>
      </button>
    </div>

		<script>
			function applyTheme() {
				const themeToggle = document.getElementById('theme-toggle');
				if (themeToggle) {
					themeToggle.addEventListener('click', () => {
						const currentTheme = document.documentElement.getAttribute('data-theme');
						const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
						document.documentElement.setAttribute('data-theme', newTheme);
						localStorage.setItem('theme', newTheme);
					});
				}
			}

      function setupAITutor() {
        const toggle = document.getElementById('ai-toggle');
        const chat = document.getElementById('ai-chat');
        const close = document.getElementById('close-chat');
        const send = document.getElementById('send-msg');
        const input = document.getElementById('user-input') as HTMLInputElement;
        const messages = document.getElementById('chat-messages');
        const personality = document.getElementById('ai-personality') as HTMLSelectElement;

        const knowledge = {
          minecraft: "Para crear un plugin de Minecraft, necesitas Java 17+ y la API de Paper. Empieza por el archivo plugin.yml y la clase principal que extiende JavaPlugin.",
          web: "El desarrollo web moderno usa frameworks como Astro para velocidad (islas de interactividad) y Next.js para aplicaciones dinámicas complejas.",
          prompts: "Un buen prompt debe tener: Rol (quién es la IA), Contexto (qué está pasando), Tarea (qué debe hacer) y Formato (cómo debe responder).",
          git: "Git es para control de versiones local. GitHub es la plataforma en la nube para colaborar. Usa 'git commit' para guardar y 'git push' para subir.",
          linkedin: "En LinkedIn, optimiza tu 'About' con palabras clave, usa una foto profesional y comparte tus proyectos de L-Academy.",
          python: "Python es el lenguaje rey de la IA. Úsalo para automatizar tareas, analizar datos o crear bots con librerías como Selenium o PyAutoGUI.",
          cyber: "La ciberseguridad empieza por nunca confiar en la entrada del usuario. Sanitiza tus formularios y usa HTTPS en todos tus sitios.",
          video: "Dominar la IA para video implica usar Runway Gen-2 para clips cinematográficos y HeyGen para avatares. ¿Sabías que puedes animar fotos estáticas con Pika Labs?",
          astro: "Astro es el framework que usamos aquí. Es ideal porque elimina el JS innecesario, haciendo que L-Academy cargue en milisegundos.",
          react: "React es una librería de JS para crear interfaces basadas en componentes. Es el estándar de la industria actual.",
          java: "Java es un lenguaje robusto y tipado. Si aprendes Java, aprender C# o C++ te será mucho más fácil.",
          sql: "SQL es el lenguaje para hablar con bases de datos relacionales como PostgreSQL o MySQL.",
          docker: "Docker empaqueta tu app en contenedores para que funcione igual en cualquier servidor VPS.",
          api: "Una API permite que dos sistemas hablen entre sí. REST y GraphQL son los estilos más comunes.",
          vps: "Tu VPS es tu propio servidor en la nube. Úsala para desplegar tus proyectos con Nginx y PM2.",
          imagenes: "Para imágenes pro, usa Midjourney para arte y DALL-E 3 para precisión. El secreto está en los 'Descriptor Prompts' como '--ar 16:9'.",
          srxmateo: "SrxMateo es el arquitecto detrás de LumaXCorp y el creador de este ecosistema de aprendizaje.",
          luma: "LumaXCorp y LumaXStudio son las entidades que impulsan el desarrollo tecnológico de estos proyectos."
        };

        const getContextGreeting = () => {
          const path = window.location.pathname;
          if (path.includes('minecraft')) return "¡Hola! Veo que te interesa Minecraft. ¿Quieres saber cómo registrar un evento en Java?";
          if (path.includes('cyber')) return "La seguridad es vital. ¿Tienes dudas sobre cómo proteger tus endpoints?";
          if (path.includes('python')) return "Python es genial para bots. ¿Te ayudo con algún script de automatización?";
          if (path.includes('video')) return "El video con IA es el futuro. ¿Hablamos de Runway o HeyGen?";
          return "¡Hola! Soy tu tutor de L-Academy. Puedo responder sobre Programación, IA, VPS o Seguridad. ¿Qué quieres aprender hoy?";
        };

        toggle?.addEventListener('click', () => {
          chat?.classList.toggle('hidden');
          if (!chat?.classList.contains('hidden') && messages?.children.length <= 1) {
            addMessage(getContextGreeting(), 'bot');
          }
        });

        close?.addEventListener('click', () => chat?.classList.add('hidden'));

        const addMessage = (text: string, type: 'user' | 'bot') => {
          if (!messages) return;
          const wrapper = document.createElement('div');
          wrapper.className = `msg-wrapper ${type}`;
          
          const avatar = document.createElement('div');
          avatar.className = 'msg-avatar';
          avatar.textContent = type === 'bot' ? '🤖' : '👨‍💻';
          
          const msg = document.createElement('div');
          msg.className = `msg ${type}`;
          msg.textContent = text;
          
          wrapper.appendChild(avatar);
          wrapper.appendChild(msg);
          messages.appendChild(wrapper);
          messages.scrollTop = messages.scrollHeight;
        };

        const personalityTabs = document.querySelectorAll('.p-tab');
        let currentPersonality = 'standard';

        personalityTabs.forEach(tab => {
          tab.addEventListener('click', () => {
            personalityTabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            currentPersonality = tab.getAttribute('data-value') || 'standard';
            
            const pNames: Record<string, string> = { standard: 'Normal', socratic: 'Socrático', strict: 'Estricto' };
            addMessage(`Cambio de modo a: ${pNames[currentPersonality]}`, 'bot');
          });
        });

        const handleSend = (customText?: string) => {
          const val = customText || input?.value.toLowerCase().trim();
          if (!val) return;
          addMessage(customText || input.value, 'user');
          if (!customText) input.value = '';

          setTimeout(() => {
            let response = "Es una buena pregunta. Mi base de datos actual cubre Astro, Java, Python, VPS, Docker, Ciberseguridad e IA. ¿Podrías ser más específico?";
            
            const keys = Object.keys(knowledge);
            const match = keys.find(key => val.toLowerCase().includes(key));
            
            if (match) {
              response = knowledge[match as keyof typeof knowledge];
            } else if (val.toLowerCase().includes("que puedes") || val.toLowerCase().includes("ayuda") || val.toLowerCase().includes("puedes hacer")) {
              response = "Puedo explicarte conceptos de: \n1. Programación (Java, Python, Astro)\n2. Servidores (VPS, Docker, SQL)\n3. IA (Prompts, Video, Imágenes)\n4. Tu carrera (LinkedIn, GitHub).";
            }

            if (currentPersonality === 'socratic') {
              response = `¿Y cómo crees tú que ese concepto encaja en un proyecto real? ${response}`;
            } else if (currentPersonality === 'strict') {
              response = `¡Escucha bien! Esto es fundamental: ${response} Asegúrate de practicarlo hoy mismo.`;
            }

            addMessage(response, 'bot');
          }, 600);
        };

        send?.addEventListener('click', () => handleSend());
        input?.addEventListener('keypress', (e) => { if (e.key === 'Enter') handleSend(); });

        // Sugerencias
        document.querySelectorAll('.suggestion-chip').forEach(chip => {
          chip.addEventListener('click', () => {
            handleSend(chip.textContent || '');
          });
        });
      }

      function setupAchievements() {
        const toast = document.getElementById('achievement-toast');
        const nameEl = document.getElementById('achievement-name');
        const iconEl = document.getElementById('achievement-icon');
        const xpEl = document.getElementById('achievement-xp');

        window.unlockAchievement = (id: string, name: string, icon: string, xp: number) => {
          const unlocked = JSON.parse(localStorage.getItem('lacademy_achievements') || '[]');
          if (unlocked.includes(id)) return;

          unlocked.push(id);
          localStorage.setItem('lacademy_achievements', JSON.stringify(unlocked));

          // Actualizar XP
          const currentXP = parseInt(localStorage.getItem('lacademy_xp') || '0');
          localStorage.setItem('lacademy_xp', (currentXP + xp).toString());

          // Mostrar Toast
          if (toast && nameEl && iconEl && xpEl) {
            nameEl.textContent = name;
            iconEl.textContent = icon;
            xpEl.textContent = `+${xp} XP`;
            toast.classList.add('active');
            
            // Sonido opcional (puedes añadir uno luego)
            setTimeout(() => toast.classList.remove('active'), 5000);
          }
        };

        // Logros automáticos
        if (window.location.pathname === '/leaderboard') {
          window.unlockAchievement('explorer-rank', 'Espíritu Competitivo', '🥈', 200);
        }
      }

      function setupNotifications() {
        const toast = document.getElementById('luma-toast');
        const messageEl = document.getElementById('toast-message');
        const iconEl = document.getElementById('toast-icon');
        const pb = document.getElementById('toast-pb');

        window.notify = (message: string, icon: string = '✨', type: 'success' | 'error' | 'info' = 'success') => {
          if (toast && messageEl && iconEl && pb) {
            // Limpiar clases previas
            toast.className = 'luma-toast active ' + type;
            messageEl.textContent = message;
            iconEl.textContent = icon;

            // Reset animación de barra de progreso
            pb.style.animation = 'none';
            pb.offsetHeight; // trigger reflow
            pb.style.animation = 'toast-timer 3s linear forwards';
            
            setTimeout(() => toast.classList.remove('active'), 3000);
          }
        };
      }

			// Run on first load
			applyTheme();
      setupAITutor();
      setupParticles();
      setupConsole();
      setupAchievements();
      setupNotifications();

			// Run on every view transition
			document.addEventListener('astro:after-swap', () => {
        applyTheme();
        setupAITutor();
        setupParticles();
        setupConsole();
        setupAchievements();
        setupNotifications();
      });

      function setupParticles() {
        const canvas = document.getElementById('particles-canvas') as HTMLCanvasElement;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        const particles: any[] = [];
        for (let i = 0; i < 50; i++) {
          particles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            vx: (Math.random() - 0.5) * 0.5,
            vy: (Math.random() - 0.5) * 0.5,
            size: Math.random() * 2
          });
        }

        function animate() {
          ctx?.clearRect(0, 0, canvas.width, canvas.height);
          ctx!.fillStyle = document.documentElement.getAttribute('data-theme') === 'dark' ? '#fff' : '#000';
          
          particles.forEach(p => {
            p.x += p.vx;
            p.y += p.vy;
            if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
            if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
            ctx?.beginPath();
            ctx?.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx?.fill();
          });
          requestAnimationFrame(animate);
        }
        animate();
      }

      function setupConsole() {
        const consoleEl = document.getElementById('luma-console');
        const input = document.getElementById('console-input') as HTMLInputElement;
        const output = document.getElementById('console-output');

        document.addEventListener('keydown', (e) => {
          if (e.ctrlKey && e.key === 'k') {
            e.preventDefault();
            consoleEl?.classList.toggle('open');
            if (consoleEl?.classList.contains('open')) input?.focus();
          }
          if (e.key === 'Escape') consoleEl?.classList.remove('open');
        });

        input?.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            const cmd = input.value.toLowerCase().trim();
            
            // Logro por usar la terminal
            if (window.unlockAchievement) {
              window.unlockAchievement('terminal-user', 'Hacker Junior', '⌨️', 300);
            }

            const log = (text: string) => {
              if (output) output.innerHTML = `<div>> ${text}</div>` + output.innerHTML;
            };

            if (cmd === 'help') log('Comandos: help, clear, theme, goto [página], status, whoami, neofetch, matrix');
            else if (cmd === 'clear') { if (output) output.innerHTML = ''; }
            else if (cmd === 'theme') {
              const current = document.documentElement.getAttribute('data-theme');
              const next = current === 'dark' ? 'light' : 'dark';
              document.documentElement.setAttribute('data-theme', next);
              localStorage.setItem('theme', next);
              log(`Tema cambiado a ${next}`);
            }
            else if (cmd.startsWith('goto ')) {
              const page = cmd.split(' ')[1];
              const pages: Record<string, string> = {
                'home': '/',
                'images': '/imagenes',
                'web': '/paginas-web',
                'video': '/ai-video',
                'study': '/estudio',
                'mc': '/minecraft-plugins',
                'cyber': '/cyber-sec',
                'python': '/python-auto',
                'tools': '/herramientas-pro',
                'cert': '/certificate',
                'ranking': '/leaderboard'
              };
              if (pages[page]) {
                log(`Navegando a ${page}...`);
                setTimeout(() => window.location.href = pages[page], 500);
              } else {
                log(`Error: Página '${page}' no encontrada.`);
              }
            }
            else if (cmd === 'status') {
              const progress = JSON.parse(localStorage.getItem('lacademy_progress') || '{}');
              const xp = localStorage.getItem('lacademy_xp') || '0';
              const completed = Object.values(progress).filter(Boolean).length;
              log(`USER: SrxMateo Colaborador`);
              log(`XP: ${xp}`);
              log(`CURSOS COMPLETADOS: ${completed}/9`);
            }
            else if (cmd === 'whoami') {
              log('L-Academy: Una visión de SrxMateo & LumaXCorp.');
              log('Desarrollado en LumaXStudio con Astro 4.0.');
            }
            else if (cmd === 'neofetch') {
              log('<span style="color:var(--primary)">L-Academy OS</span>');
              log('------------------');
              log('Host: LumaX-Server-v5');
              log('Kernel: Astro 4.15.1');
              log('Shell: LumaConsole-v2.0');
              log('Theme: Glass-Morphism-Pro');
              log('Developer: SrxMateo');
              log('Studio: LumaXStudio');
            }
            else if (cmd === 'matrix') {
              log('Inyectando modo hacker...');
              document.body.style.filter = 'hue-rotate(90deg) brightness(1.2)';
              setTimeout(() => {
                document.body.style.filter = '';
                log('Hackeo completado. Estás a salvo.');
              }, 3000);
            }
            else log(`Comando desconocido: ${cmd}`);
            
            input.value = '';
          }
        });
      }
		</script>

